rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPlayerAccount(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 50 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
             data.authMethod is string &&
             (data.authMethod == 'gmail' || data.authMethod == 'account') &&
             data.campaignLevelIndex is int &&
             data.campaignLevelIndex >= 0 &&
             data.campaignLevelIndex <= 1000 &&
             data.coins is int &&
             data.coins >= 0 &&
             data.coins <= 10000000 &&
             data.perfectCount is int &&
             data.perfectCount >= 0 &&
             data.perfectCount <= 1000000 &&
             data.currentStreak is int &&
             data.currentStreak >= 0 &&
             data.currentStreak <= 1000000 &&
             data.maxStreak is int &&
             data.maxStreak >= 0 &&
             data.maxStreak <= 1000000 &&
             data.completedLevelsCount is int &&
             data.completedLevelsCount >= 0 &&
             data.completedLevelsCount <= 1000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /players/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId',
                         'displayName',
                         'authMethod',
                         'campaignLevelIndex',
                         'coins',
                         'perfectCount',
                         'currentStreak',
                         'maxStreak',
                         'completedLevelsCount',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'displayName',
                         'email',
                         'authMethod',
                         'campaignLevelIndex',
                         'coins',
                         'perfectCount',
                         'currentStreak',
                         'maxStreak',
                         'completedLevelsCount',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidPlayerAccount(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidPlayerAccount(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName',
                         'email',
                         'authMethod',
                         'campaignLevelIndex',
                         'coins',
                         'perfectCount',
                         'currentStreak',
                         'maxStreak',
                         'completedLevelsCount',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
