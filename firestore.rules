rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Block known junk/test UIDs from PlayerAccountRepository.kt
    function isNotJunkUid(uid) {
      return !(uid in [
        'usr_asdasda',
        'usr_irbdhejebdiensishdbsiej',
        'usr_jrjdhdhdhisdj',
        'usr_jsjsjsj',
        'usr_ndjdjsjd',
        'usr_nsjsj',
        'usr_sdfdsfsd',
        'usr_udjdjd'
      ]);
    }

    function isAuthorizedPlayerDoc(playerId) {
      return isNotJunkUid(playerId) && (
        playerId.matches('^usr_[a-z0-9_]{1,60}$') ||
        (request.auth != null && request.auth.uid == playerId)
      );
    }

    // Helper: Validate PlayerAccount schema & value ranges
    function isValidPlayerAccount(data, docId) {
      return data.keys().hasAll([
          'userId', 'displayName', 'authMethod',
          'campaignLevelIndex', 'coins'
        ])
        && data.userId is string
        && data.userId == docId
        && data.userId.size() >= 3
        && data.userId.size() <= 64
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 50
        && data.authMethod in ['gmail', 'account', 'email', 'google']
        && data.campaignLevelIndex is number
        && data.campaignLevelIndex >= 0
        && data.campaignLevelIndex <= 1000
        && data.coins is number
        && data.coins >= 0
        && data.coins <= 10000000
        && (!('perfectCount' in data) || (data.perfectCount is number && data.perfectCount >= 0 && data.perfectCount <= 1000000))
        && (!('currentStreak' in data) || (data.currentStreak is number && data.currentStreak >= 0 && data.currentStreak <= 1000000))
        && (!('maxStreak' in data) || (data.maxStreak is number && data.maxStreak >= 0 && data.maxStreak <= 1000000))
        && (!('completedLevelsCount' in data) || (data.completedLevelsCount is number && data.completedLevelsCount >= 0 && data.completedLevelsCount <= 1000));
    }

    match /players/{playerId} {
      // 1. Direct single-document lookup (`docRef.get()`)
      allow get: if isAuthorizedPlayerDoc(playerId);

      // 2. Collection queries (`whereEqualTo` in findPlayerAccountByIdentifier) & console inspection
      allow list: if true;

      // 3. Account creation: Must pass schema validation & not be a junk UID
      allow create: if isAuthorizedPlayerDoc(playerId)
        && isValidPlayerAccount(request.resource.data, playerId);

      // 4. Progress updates: Must pass schema validation & cannot alter userId
      allow update: if isAuthorizedPlayerDoc(playerId)
        && isValidPlayerAccount(request.resource.data, playerId)
        && (!('userId' in resource.data) || request.resource.data.userId == resource.data.userId);

      // 5. Never allow client-side deletes
      allow delete: if false;
    }

    // Deny access to any other unknown collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}